<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:GarageTrack.Controls"
             xmlns:helpers="clr-namespace:GarageTrack.Helpers"
             xmlns:vm="clr-namespace:GarageTrack.ViewModels"
             x:Class="GarageTrack.Views.RegisterPage"
             x:DataType="vm:RegisterViewModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="24,20,24,32">

            <!-- En-tête -->
            <Grid ColumnDefinitions="Auto,*" HeightRequest="48">
                <Grid WidthRequest="44" HeightRequest="44" Margin="-10,0,0,0">
                    <controls:Icon Glyph="{x:Static helpers:Icons.ArrowLeft}" Color="{StaticResource Primary}" Size="24" />
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                    </Grid.GestureRecognizers>
                </Grid>
                <Label Grid.Column="1" Text="BIENVENUE" Style="{StaticResource Overline}"
                       HorizontalOptions="End" VerticalOptions="Center" />
            </Grid>

            <Label Text="Créez votre atelier" Style="{StaticResource H1}" Margin="0,16,0,0" />
            <Label Text="Un compte pour toute votre activité." Style="{StaticResource Subtitle}" Margin="0,8,0,0" />

            <HorizontalStackLayout Spacing="14" Margin="0,22,0,6">
                <Border BackgroundColor="{StaticResource Primary}" StrokeThickness="0"
                        StrokeShape="RoundRectangle 12" WidthRequest="56" HeightRequest="56">
                    <controls:Icon Glyph="{x:Static helpers:Icons.Wrench}" Color="White" Size="26" />
                </Border>
                <VerticalStackLayout VerticalOptions="Center">
                    <Label Text="GarageTrack" FontFamily="InterBold" FontSize="26" TextColor="{StaticResource Primary}" />
                    <Label Text="AUTOMOBILE" Style="{StaticResource Overline}" />
                </VerticalStackLayout>
            </HorizontalStackLayout>

            <Label Text="Nom et prénom *" Style="{StaticResource FieldLabel}" />
            <Border Style="{StaticResource Field}">
                <Entry Text="{Binding FullName}" Placeholder="Rodrigue Fokou" />
            </Border>

            <Label Text="Nom du garage *" Style="{StaticResource FieldLabel}" />
            <Border Style="{StaticResource Field}">
                <Grid ColumnDefinitions="*,Auto">
                    <Entry Text="{Binding GarageName}" Placeholder="Garage du Wouri" />
                    <controls:Icon Grid.Column="1" Glyph="{x:Static helpers:Icons.Warehouse}" Color="{StaticResource Muted}" Size="22" />
                </Grid>
            </Border>

            <Label Text="Adresse email *" Style="{StaticResource FieldLabel}" />
            <Border Style="{StaticResource Field}">
                <Grid ColumnDefinitions="*,Auto">
                    <Entry Text="{Binding Email}" Keyboard="Email" Placeholder="nom@gmail.com" />
                    <controls:Icon Grid.Column="1" Glyph="{x:Static helpers:Icons.Mail}" Color="{StaticResource Muted}" Size="22" />
                </Grid>
            </Border>

            <Label Text="Téléphone *" Style="{StaticResource FieldLabel}" />
            <Border Style="{StaticResource Field}">
                <Grid ColumnDefinitions="*,Auto">
                    <Entry Text="{Binding Phone}" Keyboard="Telephone" Placeholder="6XX XX XX XX" />
                    <controls:Icon Grid.Column="1" Glyph="{x:Static helpers:Icons.Phone}" Color="{StaticResource Muted}" Size="22" />
                </Grid>
            </Border>

            <Label Text="Mot de passe *" Style="{StaticResource FieldLabel}" />
            <Border Style="{StaticResource Field}">
                <Grid ColumnDefinitions="*,Auto">
                    <Entry Text="{Binding Password}" IsPassword="{Binding IsPasswordHidden}" Placeholder="12 caractères minimum" />
                    <Grid Grid.Column="1" WidthRequest="44" HeightRequest="44" Margin="0,0,-10,0">
                        <controls:Icon Glyph="{Binding PasswordGlyph}" Color="{StaticResource Muted}" Size="22" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding TogglePasswordCommand}" />
                        </Grid.GestureRecognizers>
                    </Grid>
                </Grid>
            </Border>

            <!-- Jauge de robustesse -->
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6" Margin="0,14,0,0" HeightRequest="5">
                <BoxView Color="{Binding Bar1}" CornerRadius="3" />
                <BoxView Grid.Column="1" Color="{Binding Bar2}" CornerRadius="3" />
                <BoxView Grid.Column="2" Color="{Binding Bar3}" CornerRadius="3" />
                <BoxView Grid.Column="3" Color="{Binding Bar4}" CornerRadius="3" />
            </Grid>
            <Label Text="{Binding StrengthText}" Style="{StaticResource Caption}" Margin="0,10,0,0" />
            <Label Text="12 caractères minimum, dont un chiffre et un symbole." Style="{StaticResource Caption}" Margin="0,10,0,0" />

            <!-- CGU -->
            <Grid ColumnDefinitions="Auto,*" Margin="0,22,0,0" ColumnSpacing="10">
                <CheckBox IsChecked="{Binding AcceptTerms}" VerticalOptions="Start" />
                <Label Grid.Column="1" VerticalOptions="Center" FontSize="15"
                       Text="J’accepte les conditions générales d’utilisation et la politique de confidentialité.">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleTermsCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>

            <Label Text="Lire les CGU et la politique de confidentialité" Style="{StaticResource Link}"
                   TextDecorations="Underline" FontSize="14" Margin="52,12,0,0">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ReadTermsCommand}" />
                </Label.GestureRecognizers>
            </Label>

            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource ErrorText}" FontSize="13"
                   Margin="0,16,0,0" IsVisible="{Binding ErrorMessage, Converter={StaticResource NotEmpty}}" />

            <controls:ActionButton Text="Créer mon compte" Glyph="{x:Static helpers:Icons.ArrowRight}"
                                   Command="{Binding CreateAccountCommand}" Margin="0,24,0,0" />

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="6" Margin="0,26,0,0">
                <Label Text="Déjà inscrit ?" Style="{StaticResource Subtitle}" />
                <Label Text="Se connecter" Style="{StaticResource Link}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding LoginCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
