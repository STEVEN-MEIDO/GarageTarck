<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:GarageTrack.Controls"
             xmlns:helpers="clr-namespace:GarageTrack.Helpers"
             xmlns:models="clr-namespace:GarageTrack.Models"
             xmlns:vm="clr-namespace:GarageTrack.ViewModels"
             x:Class="GarageTrack.Views.DashboardPage"
             x:DataType="vm:DashboardViewModel"
             Title="Atelier">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="20,24,20,120">

                <!-- En-tête -->
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout>
                        <Label Text="{Binding GarageName}" FontFamily="InterSemiBold" FontSize="13"
                               TextColor="{StaticResource Primary}" CharacterSpacing="0.4" />
                        <Label Text="{Binding Greeting}" Style="{StaticResource H1}" Margin="0,6,0,0" />
                        <Label Text="{Binding TodayText}" Style="{StaticResource Subtitle}" Margin="0,6,0,0" />
                    </VerticalStackLayout>

                    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0"
                            WidthRequest="58" HeightRequest="58" VerticalOptions="Start" Margin="0,8,0,0">
                        <Grid>
                            <controls:Icon Glyph="{x:Static helpers:Icons.Bell}" Color="{StaticResource Primary}" Size="24" />
                            <Ellipse Fill="{StaticResource AccentBrush}" WidthRequest="8" HeightRequest="8"
                                     HorizontalOptions="End" VerticalOptions="Start" Margin="0,14,16,0" />
                        </Grid>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NotificationsCommand}" />
                        </Border.GestureRecognizers>
                    </Border>
                </Grid>

                <!-- Recherche -->
                <Border Style="{StaticResource Field}" Margin="0,26,0,0" Padding="16,0,8,0">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <controls:Icon Glyph="{x:Static helpers:Icons.Search}" Color="{StaticResource Muted}" Size="22" />
                        <Entry Grid.Column="1" Text="{Binding SearchText}" Placeholder="Immatriculation ou n° OR"
                               ClearButtonVisibility="WhileEditing" ReturnType="Search" />
                    </Grid>
                </Border>

                <!-- Indicateurs -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="16" Margin="0,24,0,0">
                    <Border BackgroundColor="{StaticResource Primary}" StrokeShape="RoundRectangle 16"
                            Stroke="{StaticResource Accent}" StrokeThickness="0" Padding="22,20">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsRepairsSelected}" Value="True">
                                <Setter Property="StrokeThickness" Value="3" />
                            </DataTrigger>
                        </Border.Triggers>
                        <VerticalStackLayout Spacing="10">
                            <controls:Icon Glyph="{x:Static helpers:Icons.Wrench}" Color="#F5C2CF" Size="24" HorizontalOptions="Start" />
                            <Label Text="{Binding RepairsCount}" FontFamily="InterBold" FontSize="44" TextColor="White" />
                            <Label Text="Réparations en cours" FontSize="15" TextColor="#FBE0E7" />
                        </VerticalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding FilterRepairsCommand}" />
                        </Border.GestureRecognizers>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="22,20">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsQuotesSelected}" Value="True">
                                <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                <Setter Property="StrokeThickness" Value="2" />
                            </DataTrigger>
                        </Border.Triggers>
                        <VerticalStackLayout Spacing="10">
                            <controls:Icon Glyph="{x:Static helpers:Icons.FileText}" Color="{StaticResource Primary}" Size="24" HorizontalOptions="Start" />
                            <Label Text="{Binding QuotesCount}" FontFamily="InterBold" FontSize="44" TextColor="{StaticResource Primary}" />
                            <Label Text="Devis à valider" Style="{StaticResource Subtitle}" />
                        </VerticalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding FilterQuotesCommand}" />
                        </Border.GestureRecognizers>
                    </Border>
                </Grid>

                <!-- Liste des OR -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,32,0,16">
                    <Label Text="{Binding ListTitle}" Style="{StaticResource H2}" />
                    <Label Grid.Column="1" Text="{Binding SeeAllText}" Style="{StaticResource Link}" VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SeeAllCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <VerticalStackLayout Spacing="14" BindableLayout.ItemsSource="{Binding Orders}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:RepairOrder">
                            <Border Style="{StaticResource Card}" Padding="18,16">
                                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="4">
                                    <controls:LicensePlate Plate="{Binding Vehicle.Plate}" Margin="0,0,0,10" />
                                    <controls:StatusBadge Grid.Column="1" Status="{Binding Status}" VerticalOptions="Start" />
                                    <Label Grid.Row="1" Text="{Binding VehicleAndClient}" FontFamily="InterSemiBold" FontSize="16" />
                                    <Label Grid.Row="2" Text="{Binding NumberAndTime}" Style="{StaticResource Caption}" />
                                    <controls:Icon Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" HorizontalOptions="End"
                                                   Glyph="{x:Static helpers:Icons.ChevronRight}" Color="{StaticResource Muted}" Size="22" />
                                </Grid>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnOrderTapped" />
                                </Border.GestureRecognizers>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- État vide -->
                <Border Style="{StaticResource Card}" IsVisible="{Binding IsEmpty}" Padding="24">
                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                        <controls:Icon Glyph="{x:Static helpers:Icons.FileText}" Color="{StaticResource Muted}" Size="28" />
                        <Label Text="Aucun ordre de réparation" FontFamily="InterSemiBold" HorizontalTextAlignment="Center" />
                        <Label Text="Vérifiez la plaque ou créez un OR à l’aide du bouton +." Style="{StaticResource Caption}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Action flottante -->
        <HorizontalStackLayout HorizontalOptions="End" VerticalOptions="End" Spacing="16" Margin="0,0,20,22">
            <Border BackgroundColor="#F2F8FAFC" StrokeThickness="0" StrokeShape="RoundRectangle 8"
                    Padding="10,6" VerticalOptions="Center">
                <Label Text="Nouvel ordre de réparation" FontFamily="InterMedium" FontSize="15" TextColor="{StaticResource Muted}" />
            </Border>
            <Border BackgroundColor="{StaticResource Accent}" StrokeThickness="0" StrokeShape="RoundRectangle 18"
                    WidthRequest="68" HeightRequest="68">
                <Border.Shadow>
                    <Shadow Brush="#F97316" Opacity="0.35" Radius="14" Offset="0,6" />
                </Border.Shadow>
                <controls:Icon Glyph="{x:Static helpers:Icons.Plus}" Color="White" Size="30" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NewOrderCommand}" />
                </Border.GestureRecognizers>
            </Border>
        </HorizontalStackLayout>
    </Grid>
</ContentPage>
