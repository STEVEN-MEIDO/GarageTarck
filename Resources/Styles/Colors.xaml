<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Palette du système d'interface GarageTrack -->
    <Color x:Key="Primary">#7B1E3A</Color>
    <Color x:Key="PrimaryDark">#5C1529</Color>
    <Color x:Key="PrimarySoft">#FDF2F4</Color>
    <Color x:Key="PrimaryLine">#F3C6D1</Color>
    <Color x:Key="Accent">#F97316</Color>
    <Color x:Key="AccentDark">#EA580C</Color>
    <Color x:Key="Background">#F8FAFC</Color>
    <Color x:Key="CardColor">#FFFFFF</Color>
    <Color x:Key="TextMain">#1E293B</Color>
    <Color x:Key="Muted">#64748B</Color>
    <Color x:Key="Placeholder">#94A3B8</Color>
    <Color x:Key="Border">#E2E8F0</Color>
    <Color x:Key="Segment">#E2E8F0</Color>
    <Color x:Key="TableHeader">#F8FAFC</Color>

    <Color x:Key="Success">#10B981</Color>
    <Color x:Key="SuccessText">#047857</Color>
    <Color x:Key="SuccessSoft">#ECFDF5</Color>
    <Color x:Key="Warning">#F59E0B</Color>
    <Color x:Key="WarningText">#C2410C</Color>
    <Color x:Key="WarningSoft">#FFF7ED</Color>
    <Color x:Key="Error">#EF4444</Color>
    <Color x:Key="ErrorText">#B91C1C</Color>
    <Color x:Key="ErrorSoft">#FEF2F2</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Border}" />
</ResourceDictionary>
