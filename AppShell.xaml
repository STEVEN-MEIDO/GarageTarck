<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="GarageTrack.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:GarageTrack.Views"
       Shell.NavBarIsVisible="False"
       Shell.FlyoutBehavior="Disabled"
       Shell.TabBarBackgroundColor="{StaticResource CardColor}"
       Shell.TabBarForegroundColor="{StaticResource Primary}"
       Shell.TabBarTitleColor="{StaticResource Primary}"
       Shell.TabBarUnselectedColor="{StaticResource Muted}"
       Shell.BackgroundColor="{StaticResource Background}">

    <!-- Authentification (hors barre d'onglets) -->
    <ShellContent Route="login"
                  ContentTemplate="{DataTemplate views:LoginPage}" />

    <!-- Application principale : 4 destinations -->
    <TabBar Route="main">
        <ShellContent Title="Atelier" Route="atelier" Icon="tab_atelier.png"
                      ContentTemplate="{DataTemplate views:DashboardPage}" />
        <ShellContent Title="Clients" Route="clients" Icon="tab_clients.png"
                      ContentTemplate="{DataTemplate views:ClientsPage}" />
        <ShellContent Title="Devis" Route="devis" Icon="tab_devis.png"
                      ContentTemplate="{DataTemplate views:QuotesPage}" />
        <ShellContent Title="Compte" Route="compte" Icon="tab_compte.png"
                      ContentTemplate="{DataTemplate views:AccountPage}" />
    </TabBar>
</Shell>
